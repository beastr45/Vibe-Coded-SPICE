{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spice Studio",
  "version": "0.1.0",
  "identifier": "com.example.spicestudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spice Studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
